# Warden (Compliance CI Gate) - environment configuration
# Copy to .env and adjust. Do NOT commit real credentials.

# ---- Analysis mode -------------------------------------------------------
# how_it_runs: "api"      - HTTP service; analyze a pull request by URL
#               "evaluation" - run the 12-scenario synthetic benchmark directly
WARDEN_MODE=api

# ---- Database ------------------------------------------------------------
# SQLite by default (zero-setup local demo). Postgres when running via docker-compose.
WARDEN_DATABASE_URL=sqlite:///./warden.db
# For docker-compose:
# WARDEN_DATABASE_URL=postgresql+psycopg://warden:warden@db:5432/warden

# ---- Git / repository access ---------------------------------------------
# Warden is read-only by default. Provide a token only when analyzing private
# GitHub repositories over HTTPS during local testing.
WARDEN_GITHUB_TOKEN=

# ---- GitHub reporting (optional) -----------------------------------------
# Minimal, least-privilege scope expected: contents:read, checks:write,
# pull_requests:write (or issues:write for comments).
WARDEN_REPORT_TARGET=report          # none | report | comment | check
WARDEN_GITHUB_APP_ID=
WARDEN_GITHUB_WEBHOOK_SECRET=
WARDEN_GITHUB_PRIVATE_KEY_PATH=

# ---- Policy enforcement ---------------------------------------------------
WARDEN_POLICY_MODE=report            # report (non-blocking) | enforce (blocking on FAIL)
WARDEN_BLOCK_ON=FAIL,ERROR           # comma-separated outcomes that fail the CI gate

# ---- LLM explanation service (optional; OFF by default) -------------------
# Warden's deterministic analysis runs fully without any LLM configured.
WARDEN_LLM_ENABLED=false
WARDEN_LLM_PROVIDER=openai_compatible
WARDEN_LLM_BASE_URL=https://api.openai.com/v1
WARDEN_LLM_API_KEY=
WARDEN_LLM_MODEL=gpt-4o-mini
WARDEN_LLM_TIMEOUT_SECONDS=20
WARDEN_MAX_RETRIES=2
WARDEN_MAX_TOKENS_BUDGET=4000

# ---- Server ---------------------------------------------------------------
WARDEN_LOG_LEVEL=INFO
WARDEN_LOG_FORMAT=json
WARDEN_MAX_DIFF_SIZE_BYTES=2000000
WARDEN_MAX_FILE_SIZE_BYTES=1000000
WARDEN_REQUEST_TIMEOUT_SECONDS=30
WARDEN_ALLOWED_REPO_HOSTS=github.com
